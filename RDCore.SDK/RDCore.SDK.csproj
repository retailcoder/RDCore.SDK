<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RDCore SDK</AssemblyTitle>
    <Description>The RDCore language model and the plumbing every process and extension of the platform shares.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the documentation file is what the API site is generated from; a public member without an xmldoc (CS1591) is not reported. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageReference Include="OmniSharp.Extensions.LanguageClient" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageProtocol" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <!-- the year of the copyright, which the platform's splash reads from the assembly (PlatformSplash.CopyrightYear); the company is the assembly's own. -->
  <ItemGroup>
    <AssemblyMetadata Include="CopyrightYear" Value="$(CopyrightYear)" />
  </ItemGroup>

  <!-- the messages a client exchanges with the platform are a package of their own, which a client references without this one. -->
  <ItemGroup>
    <PackageReference Include="RDCore.SDK.Protocols" Version="$(RDCoreSdkProtocolsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ServerOptionsHelpText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ServerOptionsHelpText.resx</DependentUpon>
    </Compile>
    <Compile Update="Exceptions.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Exceptions.resx</DependentUpon>
    </Compile>
    <Compile Update="Server\TraceMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TraceMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Server\Assistant\AssistantMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AssistantMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Forms\MSFormsMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>MSFormsMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ServerOptionsHelpText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ServerOptionsHelpText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Exceptions.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Exceptions.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Server\TraceMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TraceMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Server\Assistant\AssistantMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AssistantMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\MSFormsMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>MSFormsMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
