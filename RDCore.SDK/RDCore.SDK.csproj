<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RDCore SDK</AssemblyTitle>
    <Description>The RDCore language model and the plumbing every process and extension of the platform shares.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the documentation file is what the API site is generated from; a public member without an xmldoc (CS1591) is not reported. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="OmniSharp.Extensions.LanguageClient" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageProtocol" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <!-- the protocol ships inside this package as its own assembly, so it is no package dependency: its assembly, xmldoc and fr resources
       go in lib/, and its symbols in the .snupkg. -->
  <ItemGroup>
    <ProjectReference Include="..\RDCore.SDK.Protocol\RDCore.SDK.Protocol.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProtocolInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludeProtocolSymbolsInPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <!-- the files come from this project's own output, where the build copied them: pack runs with no build. -->
  <Target Name="IncludeProtocolInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutDir)RDCore.SDK.Protocol.dll;$(OutDir)RDCore.SDK.Protocol.xml" />
      <BuildOutputInPackage Include="$(OutDir)fr\RDCore.SDK.Protocol.resources.dll" TargetPath="fr\RDCore.SDK.Protocol.resources.dll" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeProtocolSymbolsInPackage">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="$(OutDir)RDCore.SDK.Protocol.pdb" TargetFramework="$(TargetFramework)" TargetPath="RDCore.SDK.Protocol.pdb" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Update="ServerOptionsHelpText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ServerOptionsHelpText.resx</DependentUpon>
    </Compile>
    <Compile Update="Exceptions.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Exceptions.resx</DependentUpon>
    </Compile>
    <Compile Update="Server\TraceMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TraceMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ServerOptionsHelpText.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ServerOptionsHelpText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Exceptions.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Exceptions.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Server\TraceMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TraceMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
