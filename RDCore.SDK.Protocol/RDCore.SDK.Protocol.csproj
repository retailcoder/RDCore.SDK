<Project Sdk="Microsoft.NET.Sdk">

  <!-- what a client of the RDCore platform speaks to it, and nothing of the platform itself: the .NET base library only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the package is public API, which the documentation site is generated from: nothing of it goes undocumented. -->
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <AssemblyTitle>RDCore SDK Protocol</AssemblyTitle>
    <Description>The messages a client exchanges with the RDCore platform, with no dependency on the platform itself.</Description>
    <!-- it ships inside the RDCore.SDK package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Client\LaunchMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>LaunchMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Platform\PlatformMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PlatformMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Client\LaunchMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>LaunchMessages.Designer.cs</LastGenOutput>
      <CustomToolNamespace>RDCore.SDK.Client</CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Update="Platform\PlatformMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PlatformMessages.Designer.cs</LastGenOutput>
      <CustomToolNamespace>RDCore.SDK.Platform</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>

</Project>
