<Project Sdk="Microsoft.NET.Sdk">

  <!-- what a client of the RDCore platform speaks to it, and nothing of the platform itself: the .NET base library only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the package is public API, which the documentation site is generated from: nothing of it goes undocumented. -->
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <Description>What a client of the RDCore platform speaks to it: the rdcore/* methods and their messages, the platform handshake, and how to start the language server. System.Text.Json only, no OmniSharp.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE-MIT.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
